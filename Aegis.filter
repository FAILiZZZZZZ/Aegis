#######################################################################
#
# AEGIS
#
# Original Loot Filter for Path of Exile 2
#
# Author      : FAILiZZZZZZ + ChatGPT
# Version     : 0.2.5
# Game        : Path of Exile 2
#
# Philosophy
#
#  • Softcore Trade
#  • Endgame only
#  • TradeStrict+
#  • Economy first, utility-stable rules
#  • Minimal visual noise
#  • Energy Shield focused
#  • Casters / Spirit Walker priority
#
#######################################################################


#######################################################################
# 01 - GLOBAL STYLES
#######################################################################

# The filter language has no reusable style definitions.
# Currency tiers: S+ = red/violet, S = dark orange, A = yellow, B = blue, C = white.
# Other categories may use their own visual priority styles.
# Rules intentionally do not use Continue: a matching rule is terminal.


#######################################################################
# 02 - CURRENCY
#######################################################################

# Gold: hide small stacks, retain medium stacks, and highlight large stacks.
Show
    BaseType == "Gold"
    StackSize >= 2000
    SetTextColor 255 220 0
    SetBorderColor 255 180 0
    SetBackgroundColor 50 35 0 255
    SetFontSize 45
    PlayEffect Yellow

Show
    BaseType == "Gold"
    StackSize >= 700
    SetTextColor 255 255 255
    SetBorderColor 150 150 150
    SetBackgroundColor 0 0 0 200
    SetFontSize 36

Hide
    BaseType == "Gold"
    StackSize < 700

# Tier 1 basic crafting currency is below this profile's pickup threshold.
Hide
    BaseType == "Orb of Transmutation" "Orb of Augmentation" "Regal Orb"

# Low-value shards are excluded from this endgame profile.
Hide
    BaseType == "Regal Shard"

# Scrolls are not retained in endgame maps.
Hide
    BaseType == "Scroll of Wisdom"

# Yellow - Core endgame crafting currency with a light alert.
Show
    BaseType "Orb of Alchemy" "Chaos Orb" "Exalted Orb" "Greater Regal Orb"
    SetTextColor 255 235 140
    SetBorderColor 230 210 80
    SetBackgroundColor 45 35 0 255
    SetFontSize 40
    PlayAlertSound 1 100

# S+ - Abyss omens requested for maximum visibility on a white background.
Show
    BaseType "Omen of Abyssal Echoes" "Omen of Light"
    SetTextColor 255 0 255
    SetBorderColor 255 0 0
    SetBackgroundColor 255 255 255 255
    SetFontSize 45
    PlayAlertSound 16 300

# B - Ritual and Breach progression drops receive a dark-blue style and light alert.
Show
    BaseType == "Breachstone" "Breach Tablet" "Ritual Tablet" "Lavish Wombgift" "Ornate Wombgift" "Banded Wombgift" "Signet Wombgift"
    SetTextColor 100 150 255
    SetBorderColor 70 110 220
    SetBackgroundColor 5 10 55 255
    SetFontSize 40
    PlayAlertSound 1 80

# B - Ritual omens remain visible with the same dark-blue alert style.
Show
    Class "Omen"
    SetTextColor 100 150 255
    SetBorderColor 70 110 220
    SetBackgroundColor 5 10 55 255
    SetFontSize 40
    PlayAlertSound 1 80

# S+ - Exceptional trade currency: red/violet, permanent beam and sharp alert.
Show
    BaseType "Mirror of Kalandra" "Hinekora's Lock"
    SetTextColor 255 60 60
    SetBorderColor 255 0 255
    SetBackgroundColor 90 0 45 255
    SetFontSize 45
    PlayEffect Red
    PlayAlertSound 16 300

# S - High-value currency: dark orange with a standard alert.
Show
    BaseType "Divine Orb" "Fracturing Orb" "Orb of Annulment" "Perfect Jeweller's Orb" "Perfect Chaos Orb" "Perfect Exalted Orb" "Perfect Orb of Transmutation" "Perfect Orb of Augmentation"
    SetTextColor 255 140 0
    SetBorderColor 200 80 0
    SetBackgroundColor 55 20 0 255
    SetFontSize 42
    PlayAlertSound 1 150

# Orange - Vaal, Exalted and all Essence currency.
Show
    BaseType "Vaal Orb" "Exalted Orb" "Essence"
    SetTextColor 255 140 0
    SetBorderColor 200 80 0
    SetBackgroundColor 55 20 0 255
    SetFontSize 40

# A - Valuable endgame crafting currency.
Show
    BaseType "Greater Chaos Orb" "Greater Exalted Orb" "Greater Jeweller's Orb" "Perfect Regal Orb"
    SetTextColor 255 220 0
    SetBorderColor 220 220 220
    SetBackgroundColor 20 20 20 255
    SetFontSize 40

# B - Tier 2 basic crafting currency, explicitly retained.
Show
    BaseType "Greater Orb of Transmutation" "Greater Orb of Augmentation" "Greater Regal Orb"
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38

# C - Currency, including essences, remains visible when its value is uncertain.
Show
    Class "Stackable Currency"
    SetTextColor 255 255 255
    SetBorderColor 150 150 150
    SetBackgroundColor 0 0 0 200
    SetFontSize 36


#######################################################################
# 03 - GEMS
#######################################################################

# S+ - Level 20 uncut Skill and Spirit Gems are premium endgame drops.
Show
    Class "Uncut Skill Gems" "Uncut Spirit Gems"
    GemLevel >= 20
    SetTextColor 255 60 60
    SetBorderColor 255 0 255
    SetBackgroundColor 90 0 45 255
    SetFontSize 45
    PlayEffect Red
    PlayAlertSound 16 300

# Level 17+ uncut Skill and Spirit Gems meet the requested endgame floor.
Show
    Class "Uncut Skill Gems" "Uncut Spirit Gems"
    GemLevel >= 17
    SetTextColor 255 220 0
    SetBorderColor 220 220 220
    SetBackgroundColor 20 20 20 255
    SetFontSize 40


#######################################################################
# 04 - RUNES
#######################################################################

# S - Premium runes are shown prominently.
Show
    BaseType "Masterwork Rune" "Perfect Adept Rune" "Perfect Body Rune" "Perfect Charging Rune" "Perfect Desert Rune" "Perfect Glacial Rune" "Perfect Inspiration Rune" "Perfect Iron Rune" "Perfect Mind Rune" "Perfect Rebirth Rune" "Perfect Resolve Rune" "Perfect Robust Rune" "Perfect Stone Rune" "Perfect Storm Rune" "Perfect Vision Rune" "Perfect Ward Rune"
    SetTextColor 80 255 80
    SetBorderColor 255 255 255
    SetBackgroundColor 20 20 20 255
    SetFontSize 42
    PlayAlertSound 5 250

# B - Higher-tier runes and other socketables remain visible for trade safety.
Show
    Class "Augment"
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38


#######################################################################
# 05 - WAYSTONES
#######################################################################

# S+ - Tier 16 Waystones are the highest endgame progression drops.
Show
    Class "Waystones"
    WaystoneTier >= 16
    SetTextColor 255 255 255
    SetBorderColor 255 0 255
    SetBackgroundColor 100 0 50 255
    SetFontSize 45
    PlayAlertSound 6 300

# S - Tier 15 Waystones are retained for endgame progression and trade.
Show
    Class "Waystones"
    WaystoneTier >= 15
    SetTextColor 80 255 80
    SetBorderColor 255 255 255
    SetBackgroundColor 20 20 20 255
    SetFontSize 42
    PlayAlertSound 5 250


#######################################################################
# 06 - HELMETS
#######################################################################

# C - Unidentified item tiers 1 to 3 remain visible with a reduced label size.
Show
    UnidentifiedItemTier >= 1
    UnidentifiedItemTier <= 3
    SetTextColor 255 255 255
    SetBorderColor 150 150 150
    SetBackgroundColor 0 0 0 200
    SetFontSize 36

# B - Unidentified item tiers 4 and 5 are retained across item categories.
Show
    UnidentifiedItemTier >= 4
    SetTextColor 120 180 255
    SetBorderColor 180 180 255
    SetBackgroundColor 15 15 45 255
    SetFontSize 40

# Exceptional-quality normal, magic and rare items are retained for crafting.
Show
    Rarity <= Rare
    Quality >= 21
    SetTextColor 120 210 255
    SetBorderColor 120 180 255
    SetBackgroundColor 10 25 50 255
    SetFontSize 40

# Normal Energy Shield and hybrid bases with an endgame base drop level are retained.
Show
    Class "Body Armours" "Boots" "Bucklers" "Foci" "Gloves" "Helmets" "Shields"
    Rarity Normal
    DropLevel >= 80
    BaseEnergyShield > 0
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38

# Any rare endgame equipment at item level 81+ is retained for trade.
Show
    Class "Amulets" "Belts" "Body Armours" "Boots" "Bows" "Bucklers" "Crossbows" "Foci" "Gloves" "Helmets" "One Hand Maces" "Quarterstaves" "Quivers" "Rings" "Sceptres" "Shields" "Spears" "Staves" "Talismans" "Two Hand Maces" "Wands"
    Rarity Rare
    ItemLevel >= 81
    SetTextColor 255 220 0
    SetBorderColor 220 220 220
    SetBackgroundColor 20 20 20 255
    SetFontSize 40

# Rare Energy Shield helmets are retained for caster and Spirit Walker builds.
Show
    Class "Helmets"
    Rarity Rare
    BaseEnergyShield > 0
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38


#######################################################################
# 07 - BODY ARMOURS
#######################################################################

# Rare Energy Shield body armours, including hybrid defences, are retained.
Show
    Class "Body Armours"
    Rarity Rare
    BaseEnergyShield > 0
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38


#######################################################################
# 08 - GLOVES
#######################################################################

# Rare Energy Shield gloves, including hybrid defences, are retained.
Show
    Class "Gloves"
    Rarity Rare
    BaseEnergyShield > 0
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38


#######################################################################
# 09 - BOOTS
#######################################################################

# Rare Energy Shield boots, including hybrid defences, are retained.
Show
    Class "Boots"
    Rarity Rare
    BaseEnergyShield > 0
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38


#######################################################################
# 10 - SHIELDS
#######################################################################

# Rare Energy Shield shields and bucklers are retained.
Show
    Class "Shields" "Bucklers"
    Rarity Rare
    BaseEnergyShield > 0
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38

# Rare foci are caster equipment and are kept when they provide Energy Shield.
Show
    Class "Foci"
    Rarity Rare
    BaseEnergyShield > 0
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38


#######################################################################
# 11 - WEAPONS
#######################################################################

# Rare caster weapons at item level 81+ are retained for endgame crafting.
Show
    Class "Wands" "Sceptres" "Staves"
    Rarity Rare
    ItemLevel >= 81
    SetTextColor 255 220 0
    SetBorderColor 220 220 220
    SetBackgroundColor 20 20 20 255
    SetFontSize 40


#######################################################################
# 12 - JEWELLERY
#######################################################################

# S+ - Very rare unique bases receive a red/violet beam and sharp alert.
# This is a base-type list: shared bases intentionally inherit the highest priority.
Show
    Rarity Unique
    BaseType "Primal Markings" "Stoic Sceptre" "Tribal Mask" "Golden Charm" "Heavy Belt" "Sacred Focus" "Diamond" "Vicious Talisman" "Ring" "Runic Fork" "Shrine Sceptre" "Grand Spear" "Ashbark Talisman"
    SetTextColor 255 60 60
    SetBorderColor 255 0 255
    SetBackgroundColor 90 0 45 255
    SetFontSize 45
    PlayEffect Red
    PlayAlertSound 6 300

# S - Rare unique bases receive a dark-orange style and standard alert.
# Diamond is handled above at S+ because it also contains very rare unique bases.
Show
    Rarity Unique
    BaseType "Viper Cap" "Silver Charm" "Feathered Sandals" "Armoured Cap" "Covert Hood" "Leatherbound Hood" "Stellar Amulet" "Omen Crest Shield" "Pronged Spear" "Ruby" "Emerald" "Sapphire" "Primed Quiver" "Prismatic Ring" "Ultimate Life Flask" "Ultimate Mana Flask" "Perching Staff" "Aberrant Sledge"
    SetTextColor 255 140 0
    SetBorderColor 200 80 0
    SetBackgroundColor 55 20 0 255
    SetFontSize 42
    PlayAlertSound 1 150

# Unique accessories are always visible with the dedicated unique style.
Show
    Class "Amulets" "Belts" "Rings"
    Rarity Unique
    SetTextColor 255 180 0
    SetBorderColor 255 110 0
    SetBackgroundColor 55 20 0 255
    SetFontSize 42

# Jewels are always retained for trade and build flexibility.
Show
    Class "Jewels"
    SetTextColor 255 255 255
    SetBorderColor 150 150 150
    SetBackgroundColor 0 0 0 200
    SetFontSize 36

# Rare jewellery is retained only when its item level meets the endgame floor.
Show
    Class "Amulets" "Belts" "Rings"
    Rarity Rare
    ItemLevel >= 81
    SetTextColor 255 220 0
    SetBorderColor 220 220 220
    SetBackgroundColor 20 20 20 255
    SetFontSize 40

# Rings and amulets are always retained at every rarity and item level.
Show
    Class "Amulets" "Rings"
    SetTextColor 255 255 255
    SetBorderColor 150 150 150
    SetBackgroundColor 0 0 0 200
    SetFontSize 36

# CHASE UNIQUES: add verified BaseType names here as the manual list evolves.
# Safety fallback: all uniques remain visible with the dedicated unique style.
Show
    Rarity Unique
    SetTextColor 255 180 0
    SetBorderColor 255 110 0
    SetBackgroundColor 55 20 0 255
    SetFontSize 40


#######################################################################
# 13 - LEAGUE CONTENT
#######################################################################

# Trial access items are explicitly excluded for this profile.
Hide
    BaseType "Djinn Barya" "Inscribed Ultimatum"

# Tablets, including Abyss and Expedition tablets, are always retained with a light alert.
Show
    Class "Tablet"
    SetTextColor 255 235 140
    SetBorderColor 230 210 80
    SetBackgroundColor 45 35 0 255
    SetFontSize 40
    PlayAlertSound 1 100

# Map fragments remain visible for endgame progression.
Show
    Class "Map Fragments"
    SetTextColor 120 180 255
    SetBorderColor 180 180 180
    SetBackgroundColor 15 15 15 255
    SetFontSize 38

# S+ - Expedition Logbooks are premium trade drops; Expedition currency is retained by Stackable Currency above.
Show
    Class "Expedition Logbook"
    SetTextColor 255 60 60
    SetBorderColor 255 0 255
    SetBackgroundColor 90 0 45 255
    SetFontSize 45
    PlayEffect Red
    PlayAlertSound 16 300

# Sekhemas relics are always retained.
Show
    BaseType "Amphora Relic" "Coffer Relic" "Incense Relic" "Seal Relic" "Tapestry Relic" "Urn Relic" "Vase Relic"
    SetTextColor 255 220 0
    SetBorderColor 220 220 220
    SetBackgroundColor 20 20 20 255
    SetFontSize 40


#######################################################################
# 99 - HIDE EVERYTHING ELSE
#######################################################################

# Strict endgame fallback: hide every item not selected above.
Hide
